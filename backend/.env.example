APP_NAME=Mama AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=127.0.0.1
PORT=8000

MAMA_AUTH_ENABLED=True
MAMA_OWNER_ID=local-user
MAMA_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS_LONG

MAMA_ACCOUNT_AUTH_ENABLED=True
MAMA_STATIC_TOKEN_COMPATIBILITY_ENABLED=True
MAMA_AUTH_STATIC_COMPATIBILITY_ROLES=admin,auditor,user
MAMA_AUTH_SIGNING_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
MAMA_AUTH_ACCESS_TOKEN_SECONDS=900
MAMA_AUTH_REFRESH_TOKEN_SECONDS=2592000
MAMA_AUTH_EMAIL_VERIFICATION_TOKEN_SECONDS=86400
MAMA_AUTH_PASSWORD_RESET_TOKEN_SECONDS=1800
MAMA_AUTH_DEVELOPMENT_TOKEN_EXPOSURE_ENABLED=False
MAMA_AUTH_PUBLIC_BASE_URL=http://127.0.0.1:8000
MAMA_AUTH_SMTP_HOST=
MAMA_AUTH_SMTP_PORT=587
MAMA_AUTH_SMTP_USERNAME=
MAMA_AUTH_SMTP_PASSWORD=
MAMA_AUTH_SMTP_FROM_EMAIL=
MAMA_AUTH_SMTP_USE_TLS=True
MAMA_AUTH_SMTP_TIMEOUT_SECONDS=20

MAMA_AUTH_ACCOUNT_LOCKOUT_ENABLED=True
MAMA_AUTH_ACCOUNT_FAILURE_LIMIT=5
MAMA_AUTH_ACCOUNT_FAILURE_WINDOW_SECONDS=900
MAMA_AUTH_ACCOUNT_LOCKOUT_SECONDS=900

MAMA_AUTH_TWO_FACTOR_ENABLED=True
MAMA_AUTH_TWO_FACTOR_SECRET_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG
MAMA_AUTH_TWO_FACTOR_ISSUER=Mama AI
MAMA_AUTH_TWO_FACTOR_CHALLENGE_SECONDS=300
MAMA_AUTH_TWO_FACTOR_TOTP_WINDOW=1
MAMA_AUTH_TWO_FACTOR_RECOVERY_CODE_COUNT=10

MAMA_AUTH_TRUSTED_DEVICES_ENABLED=True
MAMA_AUTH_API_KEYS_ENABLED=True
MAMA_AUTH_API_KEY_MAX_ACTIVE=10
MAMA_AUTH_API_KEY_DEFAULT_EXPIRY_DAYS=90
MAMA_AUTH_API_KEY_MAX_EXPIRY_DAYS=365

MAMA_RATE_LIMIT_ENABLED=True
MAMA_RATE_LIMIT_WINDOW_SECONDS=60
MAMA_RATE_LIMIT_GENERAL_REQUESTS=120
MAMA_RATE_LIMIT_CHAT_REQUESTS=30
MAMA_RATE_LIMIT_MEMORY_WRITE_REQUESTS=20
MAMA_RATE_LIMIT_ACTION_REQUESTS=20
MAMA_AUTH_FAILURE_LIMIT=5
MAMA_AUTH_FAILURE_WINDOW_SECONDS=60
MAMA_AUTH_COOLDOWN_SECONDS=300

GEMINI_API_KEY=REPLACE_WITH_YOUR_ROTATED_GEMINI_KEY
AI_MODEL=gemini-2.5-flash

LOG_LEVEL=INFO
MAMA_LOG_FORMAT=json
MAMA_LOG_MAX_BYTES=10485760
MAMA_LOG_BACKUP_COUNT=5
MAMA_OBSERVABILITY_ENABLED=True
MAMA_METRICS_ENABLED=True
MAMA_OBSERVABILITY_REQUEST_ID_HEADER=X-Request-ID
MAMA_OBSERVABILITY_SLOW_REQUEST_MS=1000
MAMA_OBSERVABILITY_ALERT_ERROR_RATE_PERCENT=5
MAMA_OBSERVABILITY_ALERT_MIN_REQUESTS=20
MAMA_OBSERVABILITY_ALERT_FAILED_QUEUE_JOBS=1
MAMA_OBSERVABILITY_ALERT_STALE_CLAIMS=1
DATABASE_URL=sqlite:///./mama_ai.db
MAMA_DATABASE_MIGRATIONS_ENABLED=True
MAMA_DATABASE_BACKUP_ENABLED=True
MAMA_DATABASE_BACKUP_DIR=./data/backups
MAMA_DATABASE_BACKUP_RETENTION_COUNT=14
MAMA_DATABASE_BACKUP_INTERVAL_SECONDS=21600
MAMA_DATABASE_BACKUP_MIN_INTERVAL_SECONDS=3600
MAMA_DATABASE_BACKUP_ON_STARTUP=False
MAMA_DATABASE_INTEGRITY_CHECK_MODE=quick

ENABLE_CAMERA=True
ENABLE_VOICE=True
ENABLE_MEMORY=True