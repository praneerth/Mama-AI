APP_NAME=Mama AI
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

HOST=127.0.0.1
PORT=8000

MAMA_AUTH_ENABLED=True
MAMA_OWNER_ID=local-user
MAMA_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS_LONG

MAMA_RATE_LIMIT_ENABLED=True
MAMA_RATE_LIMIT_WINDOW_SECONDS=60
MAMA_RATE_LIMIT_GENERAL_REQUESTS=120
MAMA_RATE_LIMIT_CHAT_REQUESTS=30
MAMA_RATE_LIMIT_MEMORY_WRITE_REQUESTS=20
MAMA_RATE_LIMIT_ACTION_REQUESTS=20
MAMA_AUTH_FAILURE_LIMIT=5
MAMA_AUTH_FAILURE_WINDOW_SECONDS=60
MAMA_AUTH_COOLDOWN_SECONDS=300

GEMINI_API_KEY=REPLACE_WITH_YOUR_ROTATED_GEMINI_KEY
AI_MODEL=gemini-2.5-flash

LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./mama_ai.db

ENABLE_CAMERA=True
ENABLE_VOICE=True
ENABLE_MEMORY=True
